{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@megabonk/sim": ["./packages/sim/src/index.ts"],
      "@megabonk/content": ["./packages/content/src/index.ts"],
      "@megabonk/mcp": ["./packages/mcp/src/index.ts"],
      "@megabonk/meta": ["./packages/meta/src/index.ts"],
      "@megabonk/bridge": ["./packages/bridge/src/index.ts"],
      "@megabonk/bridge/server": ["./packages/bridge/src/server.ts"]
    }
  }
}
