{
  "name": "megabonk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "npm run start:game",
    "start:game": "vite --config packages/client/vite.config.ts",
    "build": "vite build --config packages/client/vite.config.ts",
    "mcp": "tsx packages/mcp/src/server.ts",
    "agent:auto": "tsx packages/harness/src/auto.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:purity": "node scripts/check-purity.mjs",
    "bench": "tsx packages/harness/src/bench.ts",
    "ci": "npm run check:purity && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  }
}
